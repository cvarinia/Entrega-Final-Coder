# Copia este archivo como .env y completa las claves.
# El archivo .env esta en .gitignore: nunca se sube al repositorio.

# --- LLM que razona (Supervisor y agentes) -----------------------------------
# "anthropic" (el de la entrega) o "gemini".
PROVEEDOR=anthropic
ANTHROPIC_API_KEY=pega_aca_tu_clave
# Vacio = default de cada proveedor (claude-haiku-4-5-20251001 / gemini-3.6-flash).
MODELO_LLM=
TEMPERATURA=0

# --- Embeddings del RAG (SIEMPRE Gemini, aunque el LLM sea Claude) ---------
# Anthropic no ofrece embeddings. Clave gratuita: https://aistudio.google.com/apikey
GOOGLE_API_KEY=pega_aca_tu_clave
# Si cambias el modelo de embeddings, el indice se reconstruye solo al arrancar.
MODELO_EMBEDDINGS=gemini-embedding-001

# --- Base vectorial (Chroma) ------------------------------------------------
# Corriendo en tu maquina: localhost y 8001 (el puerto que publica Docker).
# Dentro de Docker Compose se pisa con chroma:8000 (ver docker-compose.yml).
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Prefijo de las colecciones: headway_catalogo y headway_metodologia.
CHROMA_PREFIJO_COLECCIONES=headway
# Fragmentos que devuelve cada busqueda.
RAG_TOP_K=4

# --- Busqueda web del Agente Investigador ----------------------------------
# Clave gratuita: https://app.tavily.com
TAVILY_API_KEY=pega_aca_tu_clave

# --- Limites del grafo -------------------------------------------------------
MAX_RONDAS_SUPERVISOR=8
# Pasos internos de cada agente (cada herramienta = 2 pasos).
LIMITE_PASOS_AGENTE=25
# Busquedas + lecturas web que puede hacer el investigador antes de entregar.
MAX_CONSULTAS_WEB=8
LIMITE_RECURSION_GRAFO=40
TIMEOUT_MODELO=90

# --- API + worker + Redis (reutilizado de la PE7) ---------------------------
REDIS_URL=redis://localhost:6379/0
MAX_TRABAJOS_CONCURRENTES=5

# --- Observabilidad (Arize Phoenix) -----------------------------------------
OBSERVABILIDAD=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=headway-propuestas
